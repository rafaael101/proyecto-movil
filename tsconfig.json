{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 ya no carga los @types solo: esto le da los tipos de Jest
    // (jest, describe, it, expect), como pide la guía de Expo.
    "types": ["jest"],
    // TypeScript toma los tipos web de Firebase y ahí no está
    // getReactNativePersistence; esto le indica usar los de React Native.
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"]
    }
  }
}
